# Chave PÚBLICA do Mercado Pago (pode aparecer no navegador — é feita para isso)
VITE_MP_PUBLIC_KEY=

# Endereço do seu backend (server/api). Use http://localhost:3000 em desenvolvimento.
VITE_API_URL=/api

# Modo demonstração: true = simula PIX/cartão/boleto SEM cobrar nada.
# Deixe false quando o backend estiver de pé.
VITE_MP_MOCK=true

# ⚠️  NUNCA coloque o Access Token aqui. Ele vai no .env do BACKEND:
#     MP_ACCESS_TOKEN=APP_USR-...
